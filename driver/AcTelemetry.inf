[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=07/31/2026,0.4.0.0
CatalogFile=AcTelemetry.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=AcTelemetry,0x00000002,ServiceInstall

[DriverCopyFiles]
AcTelemetry.sys

[ServiceInstall]
DisplayName=%ServiceDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\AcTelemetry.sys

[SourceDisksFiles]
AcTelemetry.sys=1

[SourceDisksNames]
1=%InstallDiskName%,,,

[Strings]
ProviderName="Anticheat Telemetry"
ServiceDisplayName="Anticheat Kernel Telemetry"
InstallDiskName="Anticheat Kernel Telemetry Installation Media"
