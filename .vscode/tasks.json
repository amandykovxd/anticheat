{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure macOS Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "macos-debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "build macOS Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "macos-debug"
      ],
      "dependsOn": "configure macOS Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
